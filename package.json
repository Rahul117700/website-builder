{
  "name": "saas-website-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/next/dist/bin/next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "server": "node server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:report": "playwright show-report",
    "test:funnel": "playwright test tests/funnel-complete.spec.ts --project=chromium",
    "test:funnel:ui": "playwright test tests/funnel-complete.spec.ts --ui",
    "seed:test": "node scripts/seed-test-funnel.js",
    "seed:channel-templates": "npx ts-node prisma/seed-channel-templates.ts",
    "marketing:post": "node scripts/auto-post-marketing.js",
    "marketing:schedule": "node scripts/schedule-marketing-posts.js",
    "marketing:setup": "bash scripts/setup-marketing-automation.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.937.0",
    "@aws-sdk/lib-storage": "^3.937.0",
    "@aws-sdk/s3-request-presigner": "^3.946.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/generative-ai": "^0.24.1",
