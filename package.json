    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.18.1",
    "fs-extra": "^11.3.0",
    "gsap": "^3.13.0",
    "inquirer": "^13.2.5",
    "next": "13.5.4",
    "next-auth": "^4.23.1",
    "next-themes": "^0.2.1",
    "pg": "^8.11.3",
    "razorpay": "^2.9.6",
