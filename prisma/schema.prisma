generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  phone                String?
  website              String?
  status               UserStatus            @default(ACTIVE)
  communityComments    CommunityComment[]
  communityPosts       CommunityPost[]
  communityLikes       CommunityPostLike[]
  accounts             Account[]
  apiKeys              ApiKey[]
  channelSubscriptions ChannelSubscription[] @relation("UserChannelSubscriptions")
  channels             Channel[]
  products             DigitalProduct[]
  domains              Domain[]              @relation("UserDomains")
  funnels              Funnel[]
  assignedInstances    Instance[]            @relation("UserInstance")
  platformTransactions PlatformTransaction[]
  playlists            Playlist[]            @relation("UserPlaylists")
  productComments      ProductComment[]      @relation("ProductComments")
  productLikes         ProductLike[]         @relation("ProductLikes")
  channelPurchases     ProductPurchase[]     @relation("UserProductPurchases")
  productReviews       ProductReview[]       @relation("ProductReviews")
  savedProducts        ProductSave[]         @relation("UserSavedProducts")
  razorpayConfigs      RazorpayConfig[]
  sessions             Session[]
  sites                Site[]
  transactions         Transaction[]
  history              UserHistory[]         @relation("UserHistory")
  notifications        UserNotification[]    @relation("UserNotifications")
  subscriptions        UserSubscription[]

  @@map("User")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Site {
  id              String          @id @default(cuid())
  name            String
  domain          String          @unique
  subdomain       String          @unique
  type            SiteType
  status          SiteStatus      @default(ACTIVE)
  port            Int             @unique
  ipAddress       String
  description     String?
  components      Json
  settings        Json
  loadTime        Float?
  visitors        Int             @default(0)
  pageViews       Int             @default(0)
  userId          String
  templateId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  analytics       Analytics[]
  databaseEntries DatabaseEntry[]
  orders          Order[]
  products        Product[]
  template        Template?       @relation(fields: [templateId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sites")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    SiteType
  thumbnail   String?
  components  Json
  price       Float?
  isActive    Boolean  @default(true)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  sites       Site[]

  @@map("templates")
}

model DatabaseEntry {
  id        String   @id @default(cuid())
  tableName String
  data      Json
  siteId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("database_entries")
}

model Product {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Float
  comparePrice Float?
  images       String[]
  category     String?
  tags         String[]
  status       ProductStatus @default(ACTIVE)
  inventory    Int           @default(0)
  sku          String?       @unique
  weight       Float?
  dimensions   Json?
  siteId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       OrderItem[]
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("products")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  status            OrderStatus   @default(PENDING)
  total             Float
  subtotal          Float
  tax               Float         @default(0)
  shipping          Float         @default(0)
  discount          Float         @default(0)
  customerName      String
  customerEmail     String
  customerPhone     String?
  shippingAddress   Json
  billingAddress    Json
  paymentMethod     String?
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  siteId            String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
  site              Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  transaction       Transaction?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  total     Float
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Transaction {
  id                String            @id @default(cuid())
  amount            Float
  currency          String            @default("INR")
  status            TransactionStatus @default(PENDING)
  type              TransactionType
  description       String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpayRefundId  String?
  userId            String
  orderId           String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model RazorpayConfig {
  id            String   @id @default(cuid())
  keyId         String
  keySecret     String
  webhookSecret String?
  isActive      Boolean  @default(true)
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accountId     String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("razorpay_configs")
}

model PlatformSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("general")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model PlatformRazorpayConfig {
  id            String   @id @default(cuid())
  keyId         String
  keySecret     String
  accountId     String
  webhookSecret String?
  isActive      Boolean  @default(true)
  environment   String   @default("live")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("platform_razorpay_configs")
}

model PlatformTransaction {
  id             String   @id @default(cuid())
  funnelId       String
  userId         String
  customerEmail  String
  totalAmount    Float
  platformFee    Float
  userAmount     Float
  commissionRate Float
  paymentId      String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  funnel         Funnel   @relation(fields: [funnelId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@map("platform_transactions")
}

model Funnel {
  id                   String                @id @default(cuid())
  name                 String
  description          String?
  userId               String
  templateId           String?
  productId            String?               @unique
  status               FunnelStatus          @default(DRAFT)
  customizations       Json?
  sellerInfo           Json?
  published            Boolean               @default(false)
  url                  String?
  domain               String?
  visitors             Int                   @default(0)
  conversions          Int                   @default(0)
  revenue              Float                 @default(0)
  conversionRate       Float                 @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  analytics            FunnelAnalytics[]
  orders               FunnelOrder[]
  product              DigitalProduct?       @relation(fields: [productId], references: [id])
  template             FunnelTemplate?       @relation(fields: [templateId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformTransactions PlatformTransaction[]

  @@map("funnels")
}

model DigitalProduct {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        DigitalProductType
  price       Float
  currency    String             @default("INR")
  status      ProductStatus      @default(ACTIVE)
  fileUrl     String?
  fileSize    Int?
  fileType    String?
  previewUrl  String?
  downloads   Int                @default(0)
  revenue     Float              @default(0)
  sales       Int                @default(0)
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  funnel      Funnel?

  @@map("digital_products")
}

model FunnelOrder {
  id            String   @id @default(cuid())
  funnelId      String
  customerEmail String
  amount        Float
  currency      String   @default("INR")
  status        String   @default("PENDING")
  paymentId     String?
  paymentMethod String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  funnel        Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@map("funnel_orders")
}

model FunnelAnalytics {
  id        String   @id @default(cuid())
  funnelId  String
  event     String
  metadata  Json?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@map("funnel_analytics")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  permissions String[]
  lastUsed    DateTime?
  isActive    Boolean   @default(true)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Analytics {
  id                 String   @id @default(cuid())
  siteId             String
  date               DateTime
  visitors           Int
  pageViews          Int
  bounceRate         Float?
  avgSessionDuration Float?
  conversionRate     Float?
  revenue            Float?
  trafficSources     Json?
  deviceBreakdown    Json?
  visitorId          String?
  pageUrl            String?
  referrer           String?
  userAgent          String?
  browser            String?
  os                 String?
  country            String?
  city               String?
  duration           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("analytics")
}

model Instance {
  id             String         @id @default(cuid())
  port           Int            @unique
  url            String         @unique
  status         InstanceStatus @default(AVAILABLE)
  assignedUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  domains        Domain[]       @relation("InstanceDomains")
  assignedUser   User?          @relation("UserInstance", fields: [assignedUserId], references: [id])

  @@map("instances")
}

model Domain {
  id         String   @id @default(cuid())
  domain     String   @unique
  instanceId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  instance   Instance @relation("InstanceDomains", fields: [instanceId], references: [id], onDelete: Cascade)
  user       User     @relation("UserDomains", fields: [userId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model NavigationSettings {
  id        String   @id @default(cuid())
  itemName  String   @unique
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("navigation_settings")
}

model FunnelTemplate {
  id          String     @id @default(cuid())
  name        String
  type        FunnelType
  description String
  previewUrl  String
  htmlSchema  Json
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  funnels     Funnel[]

  @@map("funnel_templates")
}

model UserNotification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType     @default(INFO)
  category  NotificationCategory @default(SYSTEM)
  metadata  Json?
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())
  user      User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("user_notifications")
}

model SubscriptionPlan {
  id               String             @id @default(cuid())
  name             String
  description      String?
  price            Float
  currency         String             @default("INR")
  duration         Int
  features         Json
  isActive         Boolean            @default(true)
  maxFunnels       Int                @default(-1)
  maxProducts      Int                @default(-1)
  maxCustomDomains Int                @default(0)
  priority         Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  regionalPricing  Json?
  subscriptions    UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                String             @id @default(cuid())
  userId            String
  planId            String
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime           @default(now())
  endDate           DateTime
  autoRenew         Boolean            @default(false)
  transactionId     String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Float
  currency          String             @default("INR")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([endDate])
  @@map("user_subscriptions")
}

model NewsletterSubscription {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  source         String?
  status         NewsletterStatus @default(ACTIVE)
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@map("newsletter_subscriptions")
}

model CommunityPost {
  id          String              @id @default(cuid())
  title       String
  content     String
  authorId    String
  authorName  String
  authorEmail String
  category    String              @default("general")
  tags        String[]            @default([])
  likes       Int                 @default(0)
  views       Int                 @default(0)
  isPublished Boolean             @default(true)
  isPinned    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  comments    CommunityComment[]
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postLikes   CommunityPostLike[]

  @@map("CommunityPost")
}

model CommunityComment {
  id        String             @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children  CommunityComment[] @relation("CommentReplies")
  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("CommunityComment")
}

model CommunityPostLike {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("CommunityPostLike")
}

model Channel {
  id                   String                @id @default(cuid())
  userId               String
  name                 String
  slug                 String                @unique
  description          String?
  welcomeMessage       String?
  coverImage           String?
  profileImage         String?
  theme                Json?
  templateId           String
  customizations       Json?
  subscriptionPrice    Decimal?
  subscriptionCurrency String                @default("INR")
  subscriptionEnabled  Boolean               @default(false)
  tags                 String[]
  category             String?
  totalViews           Int                   @default(0)
  totalSubscribers     Int                   @default(0)
  totalRevenue         Decimal               @default(0)
  status               ChannelStatus         @default(DRAFT)
  published            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isPromoted           Boolean               @default(false)
  promotionExpiry      DateTime?
  adCampaigns          AdCampaign[]
  products             ChannelProduct[]
  subscribers          ChannelSubscription[]
  template             ChannelTemplate       @relation(fields: [templateId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([isPromoted])
  @@map("channels")
}

model AdCampaign {
  id                String         @id @default(cuid())
  channelId         String
  userId            String
  type              AdCampaignType
  status            AdStatus       @default(PENDING)
  goal              AdGoal
  budget            Float
  currency          String         @default("INR")
  impressions       Int            @default(0)
  clicks            Int            @default(0)
  conversions       Int            @default(0)
  spent             Float          @default(0)
  startDate         DateTime
  endDate           DateTime
  targeting         Json?
  metadata          Json?
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  channel           Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  performanceDaily  AdPerformanceDaily[]

  @@index([channelId])
  @@index([userId])
  @@index([status])
  @@map("ad_campaigns")
}

model AdPerformanceDaily {
  id          String     @id @default(cuid())
  campaignId  String
  date        DateTime
  impressions Int        @default(0)
  clicks      Int        @default(0)
  conversions Int        @default(0)
  spent       Float      @default(0)
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@map("ad_performance_daily")
}

model ChannelTemplate {
  id           String    @id @default(cuid())
  name         String
  description  String?
  category     String
  previewImage String?
  layout       Json
  sections     Json
  defaultTheme Json
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  isPremium    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  channels     Channel[]

  @@map("channel_templates")
}

model ChannelProduct {
  id               String               @id @default(cuid())
  channelId        String
  title            String
  description      String?
  type             ChannelProductType
  price            Decimal
  currency         String               @default("INR")
  isSubscriberOnly Boolean              @default(false)
  isFree           Boolean              @default(false)
  fileUrl          String?
  fileType         String?
  fileSize         Int?
  downloadLimit    Int?
  videoUrl         String?
  videoDuration    Int?
  videoProvider    String?
  previewImage     String?
  previewText      String?
  slug             String?
  tags             String[]
  viewCount        Int                  @default(0)
  purchaseCount    Int                  @default(0)
  status           ChannelProductStatus @default(DRAFT)
  published        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  likeCount        Int                  @default(0)
  saveCount        Int                  @default(0)
  channel          Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  playlistItems    PlaylistItem[]
  comments         ProductComment[]
  likes            ProductLike[]
  purchases        ProductPurchase[]
  reviews          ProductReview[]
  saves            ProductSave[]
  history          UserHistory[]        @relation("ProductHistory")

  @@index([channelId])
  @@index([status])
  @@index([published])
  @@map("channel_products")
}

model ChannelSubscription {
  id              String                    @id @default(cuid())
  channelId       String
  userId          String
  status          ChannelSubscriptionStatus
  startDate       DateTime                  @default(now())
  endDate         DateTime
  autoRenew       Boolean                   @default(true)
  amount          Decimal
  currency        String
  paymentId       String?
  razorpayOrderId String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  channel         Channel                   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User                      @relation("UserChannelSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([status])
  @@map("channel_subscriptions")
}

model ProductPurchase {
  id              String                @id @default(cuid())
  productId       String
  userId          String
  amount          Decimal
  currency        String
  paymentId       String
  razorpayOrderId String?
  status          ProductPurchaseStatus
  downloadCount   Int                   @default(0)
  lastDownloadAt  DateTime?
  createdAt       DateTime              @default(now())
  product         ChannelProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User                  @relation("UserProductPurchases", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@index([status])
  @@map("product_purchases")
}

model ProductReview {
  id        String         @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  product   ChannelProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation("ProductReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

model ProductComment {
  id        String           @id @default(cuid())
  productId String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  parent    ProductComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ProductComment[] @relation("CommentReplies")
  product   ChannelProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User             @relation("ProductComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([parentId])
  @@map("product_comments")
}

model ProductLike {
  id        String         @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime       @default(now())
  product   ChannelProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation("ProductLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("product_likes")
}

model Playlist {
  id          String         @id @default(cuid())
  name        String
  description String?
  userId      String
  isPublic    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       PlaylistItem[]
  user        User           @relation("UserPlaylists", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("playlists")
}

model PlaylistItem {
  id         String         @id @default(cuid())
  playlistId String
  productId  String
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
  playlist   Playlist       @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  product    ChannelProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([playlistId, productId])
  @@index([playlistId])
  @@index([productId])
  @@map("playlist_items")
}

model ProductSave {
  id        String         @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime       @default(now())
  product   ChannelProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation("UserSavedProducts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("product_saves")
}

model UserHistory {
  id        String         @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime       @default(now())
  product   ChannelProduct @relation("ProductHistory", fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation("UserHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([viewedAt])
  @@index([userId, viewedAt])
  @@map("user_history")
}

